# OK RICH — build-time variables (Vite exposes only VITE_* keys). Copy to .env and fill in.
# None of these are secrets; they end up in the public HTML. Never put an API key here.

# Required. VITE_PAY_URL is the Dodo Payments static payment link of the Pay What You Want
# product; the buyer picks the amount at checkout, /pay only adds the name. See docs/dodo-setup.md.
VITE_DOMAIN=ok-rich.com
VITE_SITE_TITLE=OK RICH
VITE_PAY_URL=https://checkout.dodopayments.com/buy/REPLACE_ME

# Optional, with defaults
VITE_OWNER_NAME=T
VITE_CURRENCY=EUR
VITE_MIN_AMOUNT=5
VITE_SUGGESTED_AMOUNTS=5, 10, 50

# Live counters (n8n): public GET endpoint returning {"raised":123,"visitors":456}.
# Leave empty to run without live numbers — the visitor card then hides itself and the
# meters fall back to VITE_RAISED_EUR below. Setup: docs/n8n-workflow.md §6.
VITE_STATS_URL=

# Sports car fund (the "the_goal.jpg" window): raised amount and target in EUR.
# The progress bar shows raised / target with four decimals. Update raised as money comes in.
VITE_RAISED_EUR=0
VITE_CAR_GOAL_EUR=200000

# Optional pair: set both or neither. With both set, the Umami script tag is emitted.
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=

# Runtime (nginx only): origin allowed in the CSP for the Umami script, e.g. https://umami.example.com
# Leave empty when Umami is not used.
UMAMI_ORIGIN=

# Runtime (nginx only): origin of VITE_PAY_URL, allowed as a form target in the CSP.
PAY_ORIGIN=https://checkout.dodopayments.com

# Runtime (nginx only): origin of VITE_STATS_URL, allowed in connect-src. Empty when unused.
STATS_ORIGIN=
