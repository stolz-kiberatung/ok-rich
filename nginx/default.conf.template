# nginx/default.conf.template — rendered with envsubst during the image build.
# ${UMAMI_ORIGIN} and ${STATS_ORIGIN} are build args (see Dockerfile); leave empty when unused.
# TLS, HSTS and compression-at-the-edge belong to the reverse proxy in front of this container.

# --- Access log (2026-09-03) ---------------------------------------------------------------
# The access log keeps the client address on purpose: the owner wants to be able to react to
# an incident in the days after it. Retention is therefore a host concern, not an nginx one:
# ops/logrotate-okrich.conf deletes the container log after 14 days (no archive), and /privacy
# says exactly that. Time, path, status and user agent also show which crawlers read the site.
log_format okrich '$remote_addr $time_iso8601 "$request" $status $body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    access_log /var/log/nginx/access.log okrich;

    # --- Security headers (constitution §5) ------------------------------------------------
    # Exactly two origins: the site itself and the self-hosted Umami instance.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' ${UMAMI_ORIGIN}; connect-src 'self' ${UMAMI_ORIGIN} ${STATS_ORIGIN}; img-src 'self' data:; style-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' ${PAY_ORIGIN}; upgrade-insecure-requests" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;

    # --- Compression ------------------------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_min_length 512;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml text/xml;

    # --- Caching ------------------------------------------------------------------------------
    # Vite hashes everything under /assets; HTML must always be revalidated.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' ${UMAMI_ORIGIN}; connect-src 'self' ${UMAMI_ORIGIN} ${STATS_ORIGIN}; img-src 'self' data:; style-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' ${PAY_ORIGIN}; upgrade-insecure-requests" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location ~* \.(svg|png|webp|jpg|ico|txt)$ {
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        # add_header inside a location drops every inherited header, so the ones that matter for
        # a served file are repeated here on purpose. CORP is what stops another site from
        # embedding these images as if they were its own.
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri =404;
    }

    # --- Routes -------------------------------------------------------------------------------
    # /thanks → thanks/index.html without a redirect; unknown paths → the custom 404 page.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' ${UMAMI_ORIGIN}; connect-src 'self' ${UMAMI_ORIGIN} ${STATS_ORIGIN}; img-src 'self' data:; style-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' ${PAY_ORIGIN}; upgrade-insecure-requests" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        try_files $uri $uri/index.html =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
